# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Which application-<profile>.yml is loaded. "prod" reads DB_URL/REDIS_HOST from here.
SPRING_PROFILES_ACTIVE=prod

# Port the API is published on
APP_PORT=8080

# Signing key for access tokens.
# HS512 needs a Base64-encoded key of at least 512 bits — a short passphrase will fail at startup.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=replace-me-with-openssl-rand-base64-64

# MySQL container
MYSQL_DATABASE=bank
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# How the app reaches MySQL. Inside Compose the host is the service name, "mysql".
DB_URL=jdbc:mysql://mysql:3306/bank
DB_USERNAME=root
DB_PASSWORD=change-me

# How the app reaches Redis. Inside Compose the host is the service name, "redis".
REDIS_HOST=redis
REDIS_PORT=6379

# Seed admin account. Only read when the "dev" profile is active, where the startup
# runner creates roles, permissions and this admin user if they do not already exist.
APP_ADMIN_USERNAME=admin@example.com
APP_ADMIN_PASSWORD=change-me
